# OmniBrain Environment Configuration Example

APP_NAME=OmniBrain
APP_ENV=development
APP_DEBUG=true

# Database Configuration
POSTGRES_USER=omnibrain
POSTGRES_PASSWORD=omnibrain_secret
POSTGRES_DB=omnibrain
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://omnibrain:omnibrain_secret@localhost:5432/omnibrain

# Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=omnibrain_vectors

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET_KEY=change_this_to_a_secure_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
