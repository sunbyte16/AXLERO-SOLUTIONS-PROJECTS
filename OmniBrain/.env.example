# OmniBrain Environment Configuration Template

# ==============================================================================
# Application Settings
# ==============================================================================
APP_NAME=OmniBrain
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=replace_with_a_securely_generated_app_secret_key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ==============================================================================
# AI & LLM Services (CRITICAL)
# ==============================================================================
# Provider selection: "auto" (default), "openai", or "gemini"
LLM_PROVIDER=auto

# OpenAI API Key (for GPT-4o-mini & text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (for Gemini-1.5-Flash & text-embedding-004)
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Relational Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL Override (Optional - set if connecting directly via full URI)
# DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/your_postgres_db

# ==============================================================================
# Vector Database (Qdrant)
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=omnibrain_documents

# ==============================================================================
# Caching & Session Storage (Redis)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_securely_generated_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# System, Uploads, & Logging
# ==============================================================================
MAX_UPLOAD_SIZE_MB=50
LOG_LEVEL=INFO

# ==============================================================================
# Frontend Environment Overrides (Optional)
# ==============================================================================
VITE_API_URL=http://localhost:8000/api